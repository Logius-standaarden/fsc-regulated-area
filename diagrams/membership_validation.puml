@startuml

header: Membership validation
title: Regulated Areas

frame "Membership administrator" {
    component Manager as managerMembershipAdmin
}

frame "Peer Consumer" {
    component Manager as managerPeerConsumer
}

frame "Peer Provider" {
    component Manager as managerPeerProvider
    component "Policy Decision Point" as pdp
}

managerMembershipAdmin <-- pdp: periodically synchronizes \nmembership list
managerMembershipAdmin <-- managerPeerConsumer: Contract with Peer Registration Grant

managerPeerConsumer -right-> managerPeerProvider: Contract with Service Connection Grant
managerPeerProvider -> pdp: evaluate membership \nof Regulated Area

@enduml